# Database (Neon)
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/nextsync?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-hex-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (for NextAuth Google Login)
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Cloudflare R2
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="nextsync-thumbnails"
R2_PUBLIC_URL="https://pub-xxx.r2.dev"

# Google Drive (Service Account JSON for Photographer Uploads)
GOOGLE_SERVICE_ACCOUNT_EMAIL="nextsync@project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID="root-folder-id-for-nextsync-uploads"

# Admin setup
ADMIN_STUDENT_ID="00000"
ADMIN_PASSWORD="change-this-in-production"

# Vercel Cron Security
CRON_SECRET=generate-with-openssl-rand-hex-32

# Photographer invite code
PHOTOGRAPHER_INVITE_CODE=nextsync2024
